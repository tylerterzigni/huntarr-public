# Database
POSTGRES_USER=huntarr
POSTGRES_PASSWORD=CHANGE_ME_unique_postgres_password
POSTGRES_DB=huntarr
DATABASE_URL=postgresql://huntarr:CHANGE_ME_unique_postgres_password@db:5432/huntarr

# Auth — AUTH_URL must match the URL browsers/phones use
AUTH_SECRET=CHANGE_ME_long_random_string
AUTH_URL=http://localhost:3000

# 64 hex chars: openssl rand -hex 32
# Never rotate on an existing database after saving Settings.
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32

SEED_ADMIN_EMAIL=admin@huntarr.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

NODE_ENV=production
PORT=3000
