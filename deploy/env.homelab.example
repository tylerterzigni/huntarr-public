# Copy to .env next to this compose usage (repo root or deploy folder as you prefer).
# NEVER commit the real .env.

POSTGRES_USER=huntarr
POSTGRES_PASSWORD=CHANGE_ME_unique_postgres_password
POSTGRES_DB=huntarr
DATABASE_URL=postgresql://huntarr:CHANGE_ME_unique_postgres_password@huntarr-db:5432/huntarr

AUTH_SECRET=CHANGE_ME_long_random_string
# URL browsers/phones use (include port)
AUTH_URL=http://localhost:3000

# 64 hex chars — generate once: openssl rand -hex 32
# Never rotate after saving Settings on this database.
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

SEED_ADMIN_EMAIL=admin@huntarr.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password

NODE_ENV=production
TZ=UTC
# Host publish port (container listens on 3000)
PORT=3000
